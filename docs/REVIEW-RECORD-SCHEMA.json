      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "environment_limitation"
              }
            }
          },
          "then": {
            "properties": {
              "observation": {
                "const": "unavailable"
              }
            }
          },
          "else": {
            "properties": {
              "observation": {
                "const": "not_observed"
              }
            }
          }
        }
      ]
