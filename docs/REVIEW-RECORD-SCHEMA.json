                },
                "risk_ids": {
                  "$ref": "#/$defs/riskIds"
                }
              },
              "required": [
                "status",
                "actor",
                "role",
                "recorded_at",
                "rationale",
                "evidence",
                "scenario_ids",
                "risk_ids"
              ],
              "additionalProperties": false
            }
          ]
        },
        "independent_verification": {
